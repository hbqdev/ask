# The PASSWORD lives in `secrets.env`, NOT here — see secrets.env.example.
# (Docker Compose interpolates `$` in this project .env file, which would
# mangle a password containing `$`. `secrets.env` is passed to the container
# via env_file only.) MODEL_MANAGER_PASSWORD is REQUIRED — unset ⇒ 503.
MODEL_MANAGER_PORT=3939

# The Ask worktree this manages — point it at the PROD worktree. It is mounted
# at this SAME path inside the container (see the compose volumes), and
# ASK_ENV_PATH/ASK_COMPOSE_FILE/ASK_COMPOSE_FILES MUST live under it — otherwise
# `docker compose up -d ask` (run via the docker socket) can't resolve Ask's
# relative bind mounts on the host daemon.
#
# Base compose is `name: ask-stack`, so applying without the right -p/-f set
# silently recreates the prod stack from whatever worktree you point at, and
# base-only drops the VPN overlay. So:
#   ASK_COMPOSE_FILES = base first, then every overlay the stack is deployed with
#                       (whitespace-separated). apply() uses THIS, not the single
#                       ASK_COMPOSE_FILE. Defaults to [ASK_COMPOSE_FILE] if unset.
#   ASK_COMPOSE_PROJECT = the -p project the stack runs as, pinned so an apply can
#                         never land on the wrong stack.
# These must match how the worktree is actually deployed — cross-check with:
#   docker inspect <service> --format '{{index .Config.Labels "com.docker.compose.project.config_files"}}'
ASK_REPO_DIR=/home/nightfury/selfhosted/ask-prod
ASK_ENV_PATH=/home/nightfury/selfhosted/ask-prod/.env
ASK_COMPOSE_FILE=/home/nightfury/selfhosted/ask-prod/docker-compose.yaml
ASK_COMPOSE_FILES=/home/nightfury/selfhosted/ask-prod/docker-compose.yaml /home/nightfury/selfhosted/ask-prod/docker-compose.vpn.yaml
ASK_COMPOSE_PROJECT=ask-stack
ASK_SERVICE=ask
MODEL_MANAGER_BACKUP_KEEP=20

# Cross-host reranker management (leave unset to disable — reranker model
# becomes read-only in the UI).
RERANKER_SSH_TARGET=
RERANKER_SSH_KEY=/keys/nightfurys
RERANKER_REMOTE_DIR=
RERANKER_ENV_FILE=.env
RERANKER_SERVICE=reranker
