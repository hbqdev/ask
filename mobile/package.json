{
  "name": "ask-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Ask for iOS: a bundled React app in a Capacitor shell. Not published; installed locally with Xcode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.182",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@json-render/core": "0.16.0",
    "@paralleldrive/cuid2": "2.2.2",
    "@streamdown/math": "1.0.2",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-virtual": "^3.14.22",
    "ai": "6.0.180",
    "katex": "0.16.22",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "streamdown": "2.5.0",
    "zod": "4.3.6"
